<?xml version="1.0" encoding="utf-8"?>
<!-- Call controls: raised grey circles; solid white when toggled on (muted, video off, speaker on). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="#801E1E1E" />
    <item android:state_checked="true" android:color="@color/white" />
    <item android:color="@color/surface_raised" />
</selector>
