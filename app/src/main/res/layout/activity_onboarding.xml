<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/onboardingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="40dp"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="24dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_stat_meshlive"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:accessibilityHeading="true"
            android:text="@string/onboarding_title"
            android:textAppearance="@style/TextAppearance.App.Display" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/onboarding_intro"
            android:textAppearance="@style/TextAppearance.App.BodyLarge"
            android:textColor="@color/text_secondary" />

        <include
            android:id="@+id/onboardingPointCalls"
            layout="@layout/item_onboarding_point" />

        <include
            android:id="@+id/onboardingPointLive"
            layout="@layout/item_onboarding_point" />

        <include
            android:id="@+id/onboardingPointRelay"
            layout="@layout/item_onboarding_point" />

        <TextView
            style="@style/Widget.App.SectionHeader"
            android:layout_marginTop="32dp"
            android:text="@string/onboarding_offline_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_offline_text"
            android:textAppearance="@style/TextAppearance.App.Body" />

        <TextView
            style="@style/Widget.App.SectionHeader"
            android:text="@string/onboarding_permissions_title" />

        <TextView
            android:id="@+id/onboardingPermissionList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textAppearance="@style/TextAppearance.App.Body" />

        <TextView
            android:id="@+id/onboardingPermissionResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.App.BodyLarge"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboardingPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_allow" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboardingSecondary"
            style="@style/Widget.App.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/onboarding_skip" />
    </LinearLayout>
</ScrollView>
