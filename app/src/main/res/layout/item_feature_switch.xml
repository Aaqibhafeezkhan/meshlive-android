<?xml version="1.0" encoding="utf-8"?>
<!-- One Settings > Features row: a switch and its explanation (FeatureSettingsBlock inflates one per FeatureSpec). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/featureRowSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/featureRowDescription"
        style="@style/Widget.App.Description"
        android:paddingStart="40dp" />
</LinearLayout>
