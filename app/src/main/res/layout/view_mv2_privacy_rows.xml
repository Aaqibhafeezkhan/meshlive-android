<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > Privacy rows of Messaging v2 (phase 1c, shown only with the feature on): Read receipts, Download files automatically.
     The label says what it does; the longer explanation is behind the (i) button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mv2PrivacyRows"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/mv2PrivacyReceipts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="64dp"
            android:text="@string/mv2_ui_settings_read_receipts" />

        <ImageButton
            android:id="@+id/mv2PrivacyReceiptsInfo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/info_more"
            android:padding="10dp"
            android:src="@drawable/ic_info"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/mv2PrivacyAutoRow"
            style="@style/Widget.App.Row"
            android:layout_width="0dp"
            android:layout_weight="1">

            <TextView
                style="@style/Widget.App.RowTitle"
                android:text="@string/mv2_ui_settings_autodl" />

            <TextView
                android:id="@+id/mv2PrivacyAutoValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:importantForAccessibility="no"
                android:textAppearance="@style/TextAppearance.App.Body" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/mv2PrivacyAutoInfo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/info_more"
            android:padding="10dp"
            android:src="@drawable/ic_info"
            app:tint="@color/text_secondary" />
    </LinearLayout>
</LinearLayout>
