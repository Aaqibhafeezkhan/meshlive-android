<?xml version="1.0" encoding="utf-8"?>
<!-- One background-reliability issue on the Help page: title, one line of why, and Fix (2026-10-17 redesign). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.App.SettingsCard"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/reliabilityIssueTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.App.RowLabel" />

        <TextView
            android:id="@+id/reliabilityIssueText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.App.Body" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/reliabilityIssueFix"
        style="@style/Widget.App.Button.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/reliability_fix" />
</LinearLayout>
