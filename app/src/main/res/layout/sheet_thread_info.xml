<?xml version="1.0" encoding="utf-8"?>
<!-- Conversation info: the disappearing timer and read receipts of this thread, the contact's actions, delete. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/infoName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.Readout"
            tools:text="Asha" />

        <LinearLayout
            android:id="@+id/infoTimerRow"
            style="@style/Widget.App.Row"
            android:layout_marginTop="8dp">

            <TextView
                style="@style/Widget.App.RowTitle"
                android:text="@string/mv2_ui_info_disappearing" />

            <TextView
                android:id="@+id/infoTimerValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:textAppearance="@style/TextAppearance.App.Body"
                tools:text="Off" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/infoReceipts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="64dp"
                android:text="@string/mv2_ui_info_read_receipts" />

            <ImageButton
                android:id="@+id/infoReceiptsInfo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/info_more"
                android:padding="10dp"
                android:src="@drawable/ic_info"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/infoContactRow"
            style="@style/Widget.App.Row">

            <TextView
                style="@style/Widget.App.RowTitle"
                android:text="@string/mv2_ui_info_contact" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/infoCompareRow"
            style="@style/Widget.App.Row">

            <TextView
                style="@style/Widget.App.RowTitle"
                android:text="@string/mv2_ui_info_compare" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/infoBlockRow"
            style="@style/Widget.App.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:text="@string/block_action" />

        <TextView
            android:id="@+id/infoReportRow"
            style="@style/Widget.App.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:text="@string/report_action" />

        <LinearLayout
            android:id="@+id/infoDeleteRow"
            style="@style/Widget.App.Row">

            <TextView
                style="@style/Widget.App.RowTitle"
                android:text="@string/mv2_ui_info_delete" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
