<?xml version="1.0" encoding="utf-8"?>
<!-- One message of a thread. The adapter sets the side (gravity), the bubble background (yours raised, theirs plain) and the
     card, meta and caption rows; nothing here is coloured. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/msgRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="2dp"
    android:paddingEnd="16dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:id="@+id/msgBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bubble_out"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/msgText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:autoLink="web"
            android:linksClickable="true"
            android:textAppearance="@style/TextAppearance.App.BodyLarge"
            android:textColorLink="@color/text_primary"
            tools:text="See you at the bridge" />

        <!-- File card: icon, name, size or status, progress, actions. -->
        <LinearLayout
            android:id="@+id/msgCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="220dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/msgCardHead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/msgCardIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/icon_circle_background"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/ic_file"
                    app:tint="@color/text_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/msgCardName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.App.Title"
                        tools:text="plan.pdf" />

                    <TextView
                        android:id="@+id/msgCardMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.App.Body"
                        tools:text="24 MB" />
                </LinearLayout>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/msgCardProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progressTint="@color/white"
                android:progressBackgroundTint="@color/outline_strong"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/msgCardActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-12dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/msgDisappears"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textAppearance="@style/TextAppearance.App.Label"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/msgTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.Label"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="14:02" />

            <ImageView
                android:id="@+id/msgGlyph"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:visibility="gone"
                app:tint="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- The words behind the glyph, shown after a tap on the bubble's time line. -->
    <TextView
        android:id="@+id/msgCaption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textAppearance="@style/TextAppearance.App.Body"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/msgRetry"
        style="@style/Widget.App.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mv2_ui_retry"
        android:visibility="gone" />
</LinearLayout>
