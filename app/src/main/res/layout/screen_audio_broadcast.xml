<?xml version="1.0" encoding="utf-8"?>
<!-- The audio-only broadcast screen (Design AL): no camera. Top bar like the other live screens (back, title,
     red-dot LIVE badge, timer); title and quality before Start; level meter, listener count and
     Mute / Pause / Stop while live. Added over the activity by AudioLiveController. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/audioBroadcastRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingEnd="@dimen/screen_gutter">

        <LinearLayout
            android:id="@+id/audioTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/audioBackButton"
                style="@style/Widget.App.TopIconButton"
                android:contentDescription="@string/audio_live_back"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/audioTitleText"
                style="@style/Widget.App.TopBarTitle"
                android:layout_marginStart="4dp"
                android:text="@string/audio_live_screen_title" />

            <TextView
                android:id="@+id/audioLiveBadge"
                style="@style/Widget.App.LiveBadge"
                android:visibility="gone" />

            <TextView
                android:id="@+id/audioTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/audio_live_timer_zero"
                android:textAppearance="@style/TextAppearance.App.Label"
                android:textColor="@color/text_primary"
                android:visibility="gone" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp">

                <LinearLayout
                    android:id="@+id/audioSetupGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/audioTitleGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.App.FieldLabel"
                            android:text="@string/audio_live_title_label" />

                        <EditText
                            android:id="@+id/audioTitleInput"
                            style="@style/Widget.App.EditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/audio_live_title_hint"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="textCapSentences"
                            android:maxLines="1" />
                    </LinearLayout>

                    <TextView
                        style="@style/Widget.App.FieldLabel"
                        android:layout_marginTop="24dp"
                        android:text="@string/audio_live_quality_label" />

                    <LinearLayout
                        android:id="@+id/audioQualityRow"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/segments_track"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:padding="4dp">

                        <TextView
                            android:id="@+id/audioQualityVoice"
                            style="@style/Widget.App.QualityOption"
                            android:text="@string/audio_live_quality_voice" />

                        <TextView
                            android:id="@+id/audioQualityLow"
                            style="@style/Widget.App.QualityOption"
                            android:text="@string/audio_live_quality_low" />

                        <TextView
                            android:id="@+id/audioQualityMusic"
                            style="@style/Widget.App.QualityOption"
                            android:text="@string/audio_live_quality_music" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/audioQualityDetail"
                        style="@style/Widget.App.StatusLine"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/audioLevelMeter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:contentDescription="@string/audio_live_meter_description"
                    android:max="100"
                    app:indicatorColor="@color/white"
                    app:trackColor="@color/surface_raised"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp" />

                <TextView
                    android:id="@+id/audioStatusText"
                    style="@style/Widget.App.StatusLine"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/audioNoteText"
                    style="@style/Widget.App.Description"
                    android:text="@string/audio_live_mic_note"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/audioStartButton"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/audio_live_start" />

        <LinearLayout
            android:id="@+id/audioControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="top|center_horizontal"
            android:orientation="horizontal"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/audioMuteButton"
                    style="@style/Widget.App.RoundControl"
                    android:contentDescription="@string/audio_live_mute"
                    app:icon="@drawable/ic_mic" />

                <TextView
                    android:id="@+id/audioMuteLabel"
                    style="@style/Widget.App.RoundControlLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/audio_live_mute" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/audioStopButton"
                    style="@style/Widget.App.RoundControl.Large"
                    android:contentDescription="@string/action_end_live_short"
                    app:backgroundTint="@color/live_red"
                    app:icon="@drawable/ic_stop"
                    app:iconTint="@color/white" />

                <TextView
                    style="@style/Widget.App.RoundControlLabel"
                    android:text="@string/action_end_live_short" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/audioPauseButton"
                    style="@style/Widget.App.RoundControl"
                    android:contentDescription="@string/live_control_pause"
                    app:icon="@drawable/ic_pause" />

                <TextView
                    android:id="@+id/audioPauseLabel"
                    style="@style/Widget.App.RoundControlLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/live_control_pause" />
            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/audioSwitchToVideoButton"
            style="@style/Widget.App.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:minHeight="48dp"
            android:text="@string/audio_live_switch_to_video"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
