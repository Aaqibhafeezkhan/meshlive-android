<?xml version="1.0" encoding="utf-8"?>
<!-- Messages (UI v8 monochrome): flat groups on the ground colour, shared section headers and button set. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/messagesRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/messagesBackButton"
                style="@style/Widget.App.TopIconButton"
                android:contentDescription="@string/messages_back"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                style="@style/Widget.App.TopBarTitle"
                android:text="@string/messages_title" />
        </LinearLayout>

        <TextView
            android:id="@+id/messagesIntro"
            style="@style/Widget.App.Description"
            android:layout_marginTop="8dp"
            android:text="@string/messages_intro" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/messagesAutoSyncSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawablePadding="16dp"
            android:text="@string/feature_auto_sync"
            app:drawableStartCompat="@drawable/ic_refresh"
            app:drawableTint="@color/text_secondary" />

        <TextView
            style="@style/Widget.App.Description"
            android:paddingStart="40dp"
            android:text="@string/feature_auto_sync_description" />

        <TextView
            android:id="@+id/messagesStatus"
            style="@style/Widget.App.StatusLine"
            android:text="@string/messages_starting" />

        <TextView
            style="@style/Widget.App.SectionHeader"
            android:layout_marginTop="8dp"
            android:text="@string/messages_section_card" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/messagesCopyCard"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/messages_copy_card" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/messagesAddContact"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/messages_add_contact" />
        </LinearLayout>

        <TextView
            style="@style/Widget.App.SectionHeader"
            android:text="@string/messages_section_pending" />

        <LinearLayout
            android:id="@+id/messagesPending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/Widget.App.SectionHeader"
            android:text="@string/messages_section_write" />

        <TextView
            android:id="@+id/messagesWriteTo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/messages_write_to"
            android:textAppearance="@style/TextAppearance.App.Body" />

        <Spinner
            android:id="@+id/messagesContactSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:contentDescription="@string/messages_write_to" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/messages_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/messagesInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/messagesAttachPhoto"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/messages_attach_photo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/messagesRecord"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/messages_record"
                app:icon="@drawable/ic_mic"
                app:iconTint="@color/text_primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/messagesAttachment"
            style="@style/Widget.App.StatusLine"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="@string/messages_lifetime"
                android:textAppearance="@style/TextAppearance.App.Body" />

            <Spinner
                android:id="@+id/messagesLifetimeSpinner"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="@string/messages_lifetime" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/messagesSend"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/messages_send" />

        <TextView
            android:id="@+id/messagesInboxHeader"
            style="@style/Widget.App.SectionHeader"
            android:text="@string/messages_section_inbox" />

        <LinearLayout
            android:id="@+id/messagesInbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/Widget.App.SectionHeader"
            android:text="@string/messages_section_sent" />

        <LinearLayout
            android:id="@+id/messagesSent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/messagesStorage"
            style="@style/Widget.App.Description"
            android:layout_marginTop="16dp"
            android:background="@null"
            android:paddingBottom="0dp" />
    </LinearLayout>
</ScrollView>
