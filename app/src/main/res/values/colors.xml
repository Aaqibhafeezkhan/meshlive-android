<?xml version="1.0" encoding="utf-8"?>
<!-- "Plain Signal" tokens (docs: ui-spec). Black ground, white text and actions. Red is reserved for
     live / hang up / decline / end broadcast, green for the answer button and the verified check.
     Nothing else is coloured. The app is dark in every system mode, so there is no values-night. -->
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <!-- Surfaces: ground, sheets/dialogs, raised controls, dividers. -->
    <color name="app_background">#000000</color>
    <color name="surface">#121212</color>
    <color name="surface_variant">#1E1E1E</color>
    <color name="surface_raised">#1E1E1E</color>
    <color name="outline">#262626</color>
    <color name="outline_strong">#3A3A3A</color>
    <color name="pressed_overlay">#14FFFFFF</color>
    <!-- Text -->
    <color name="text_primary">#FFFFFF</color>
    <color name="text_secondary">#A3A3A3</color>
    <color name="text_disabled">#5C5C5C</color>
    <!-- Accent = white (primary action white with black text). -->
    <color name="accent">#FFFFFF</color>
    <color name="on_accent">#000000</color>
    <color name="accent_container">#262626</color>
    <color name="on_accent_container">#FFFFFF</color>
    <!-- Semantic only -->
    <color name="success">#34C759</color>
    <color name="success_container">#1E1E1E</color>
    <color name="warning">#FFFFFF</color>
    <color name="warning_container">#1E1E1E</color>
    <color name="danger">#FF3B30</color>
    <color name="danger_container">#1E1E1E</color>
    <color name="record_red">#FF3B30</color>
    <!-- Over video -->
    <color name="overlay_scrim">#B3000000</color>
    <color name="overlay_button">#33FFFFFF</color>
    <color name="overlay_button_on">#F2FFFFFF</color>
    <color name="overlay_text">#FFFFFFFF</color>
    <color name="overlay_text_on_light">#FF000000</color>
    <color name="call_accept">#34C759</color>
    <color name="call_end">#FF3B30</color>
    <color name="live_red">#FF3B30</color>
    <color name="mismatch_red">#FF3B30</color>
    <color name="call_ground_top">#FF000000</color>
    <color name="call_ground_bottom">#FF000000</color>
    <color name="switch_track_off">#3A3A3A</color>
</resources>
