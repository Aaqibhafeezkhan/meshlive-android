<?xml version="1.0" encoding="utf-8"?>
<!-- Updates (github flavour, UpdateActivity): the online check and its install, and installing a file received from a
     nearby phone after the same checks. Shown from Settings > Features and from the home "Newer version nearby" row. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/updateRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/updateBackButton"
                style="@style/Widget.App.TopIconButton"
                android:contentDescription="@string/action_back"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                style="@style/Widget.App.TopBarTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/update_title"
                android:textAppearance="@style/TextAppearance.App.Headline" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/update_online_title"
                    android:textAppearance="@style/TextAppearance.App.Title" />

                <TextView
                    android:id="@+id/updateInstalledLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    tools:text="Installed: 0.2.0-beta (release 2)" />

                <TextView
                    android:id="@+id/updateStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="@style/TextAppearance.App.BodyLarge"
                    tools:text="Version 0.2.0 is available (11.4 MB)." />

                <ProgressBar
                    android:id="@+id/updateProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/updateDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:visibility="gone"
                    tools:text="Signed by the MeshLive release key." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/updatePrimaryButton"
                    style="@style/Widget.App.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:visibility="gone"
                    tools:text="Download" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/updateCheckButton"
                    style="@style/Widget.App.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp"
                    android:text="@string/update_check_now" />

                <TextView
                    android:id="@+id/updateOnlineOff"
                    style="@style/Widget.App.Description"
                    android:layout_marginTop="12dp"
                    android:text="@string/update_online_off"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/updateEnableButton"
                    style="@style/Widget.App.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/update_enable_checks"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/updateNearbyCard"
            style="@style/Widget.App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/update_nearby_title"
                    android:textAppearance="@style/TextAppearance.App.Title" />

                <TextView
                    android:id="@+id/updateNearbyIntro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.App.BodyLarge"
                    android:visibility="gone"
                    tools:text="A phone you connected to runs release 2." />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/update_nearby_steps"
                    android:textAppearance="@style/TextAppearance.App.Body" />

                <TextView
                    android:id="@+id/updateNearbyFingerprint"
                    style="@style/Widget.App.Description"
                    android:layout_marginTop="8dp"
                    android:textIsSelectable="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/updateChooseFileButton"
                    style="@style/Widget.App.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:text="@string/update_choose_file" />

                <TextView
                    android:id="@+id/updateNearbyResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/updateInstallPickedButton"
                    style="@style/Widget.App.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp"
                    android:text="@string/update_install"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/updateHideNearbyButton"
                    style="@style/Widget.App.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/update_hide_nearby"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Widget.App.Description"
            android:layout_marginTop="16dp"
            android:text="@string/update_privacy_note" />
    </LinearLayout>
</ScrollView>
