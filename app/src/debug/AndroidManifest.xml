<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Phone test T13 only: the debug-only updater test source (test_update_latest_url=http://host:port/...)
        is a local server standing in for GitHub. Release builds keep the default: HTTPS only.
    -->
    <application android:usesCleartextTraffic="true">
        <receiver
            android:name=".DebugTestAlertReceiver"
            android:exported="true" />
        <!-- Bluetooth restart for runners: only adb shell holds DUMP. -->
        <receiver
            android:name=".DebugBluetoothRestartReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>

</manifest>
